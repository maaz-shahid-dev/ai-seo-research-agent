# Copy to .env.local for development. Never commit real values and never prefix
# server secrets with NEXT_PUBLIC_. Use separate least-privilege database users
# for the application and migrations in production.
DATABASE_URL=
MIGRATION_DATABASE_URL=
AUTH_SECRET=
AUTH_TRUST_HOST=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=
LOG_LEVEL=info

# Local development only; never set these in production. See README "Run locally with Docker".
# RATE_LIMIT_BACKEND=memory
# INNGEST_DEV=1
